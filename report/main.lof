\contentsline {figure}{\numberline {1}{\ignorespaces Phân bố corpus theo truy vấn thu thập đầu tiên và năm xuất bản. Đây là mẫu theo relevance, không đại diện cho toàn bộ sản lượng nghiên cứu.}}{3}{figure.caption.3}%
\contentsline {figure}{\numberline {2}{\ignorespaces Kiến trúc triển khai: dữ liệu công khai, chuẩn hóa, mining core, workspace và pipeline đánh giá. Solr là backend tùy chọn có thể bật độc lập.}}{4}{figure.caption.4}%
\contentsline {figure}{\numberline {3}{\ignorespaces Màn hình tìm kiếm với query, bộ lọc, lexical/graph ranking và các paper thực trong corpus.}}{6}{figure.caption.5}%
\contentsline {figure}{\numberline {4}{\ignorespaces Màn hình đồ thị citation: mỗi cạnh là một tham chiếu quan sát, hướng từ bài trích dẫn sang bài được trích dẫn.}}{7}{figure.caption.6}%
\contentsline {figure}{\numberline {5}{\ignorespaces Project thật trong browser QA. Brief ví dụ được điền bằng nút riêng và có thể sửa; paper và cạnh lấy từ corpus. Tọa độ graph phục vụ trình bày, không biểu diễn khoảng cách ngữ nghĩa.}}{8}{figure.caption.7}%
\contentsline {figure}{\numberline {6}{\ignorespaces PDF gốc hiển thị tại trang bookmark số 4, cạnh ghi chú của người đọc. Nội dung ghi chú trong ảnh là thao tác demo; không được dùng làm nhãn thực nghiệm.}}{9}{figure.caption.8}%
\contentsline {figure}{\numberline {7}{\ignorespaces Coverage sau khử trùng của snapshot mở rộng. Các số là bản ghi thu thập được; không trộn vào corpus 3.595 paper của thí nghiệm gốc.}}{11}{figure.caption.9}%
\contentsline {figure}{\numberline {8}{\ignorespaces Tìm kiếm thật trên kho hội nghị: query graph neural networks, ICML 2025. Abstract hoặc citation count thiếu được ghi rõ; không sinh nội dung thay thế.}}{12}{figure.caption.10}%
\contentsline {figure}{\numberline {9}{\ignorespaces Search online với metadata OpenAlex thật. Paper có thể import vào reader, thêm vào Project và tham gia citation graph nếu có reference khớp. Không tạo cạnh khi nguồn không cung cấp bằng chứng.}}{13}{figure.caption.11}%
\contentsline {figure}{\numberline {10}{\ignorespaces Mạng con của 160 paper có PageRank cao nhất. Biểu đồ được dựng từ cạnh thật; nhãn chọn một số nút tiêu biểu để giảm chồng lấn.}}{15}{figure.caption.12}%
\contentsline {figure}{\numberline {11}{\ignorespaces Review thật từ PeerRead ở bên trái; phân tích một đoạn văn nhập bởi người dùng ở bên phải. Câu ví dụ trong ô nhập là ví dụ demo, không thuộc tập benchmark.}}{16}{figure.caption.13}%
\contentsline {figure}{\numberline {12}{\ignorespaces Thư viện cá nhân, xuất BibTeX và điều khiển phương pháp/diversity cho danh sách gợi ý.}}{17}{figure.caption.14}%
\contentsline {figure}{\numberline {13}{\ignorespaces BM25 đạt nDCG@10 cao hơn TF-IDF trên 300 query; error bars là bootstrap 95\%.}}{20}{figure.caption.16}%
\contentsline {figure}{\numberline {14}{\ignorespaces Personalized PageRank dẫn đầu trên phục hồi cạnh bị che; hybrid vượt content nhưng chưa vượt graph-only.}}{21}{figure.caption.18}%
\contentsline {figure}{\numberline {15}{\ignorespaces MMR nâng intra-list diversity của hybrid từ 0,406 lên 0,501 và catalog coverage từ 8,46\% lên 9,90\%; nDCG@10 đồng thời tăng trong sample.}}{22}{figure.caption.19}%
\contentsline {figure}{\numberline {16}{\ignorespaces Người đọc chọn câu mô tả TransE và TransH. Kết quả đầu trả lại câu nhắc trực tiếp đến cách các mô hình biểu diễn quan hệ bằng phép tịnh tiến.}}{25}{figure.caption.20}%
\contentsline {figure}{\numberline {17}{\ignorespaces Tìm abstract có cùng tên phương pháp trên SciERC. Hai hàng dùng cùng 172 câu và cùng ứng viên. Hàng dưới thay tên kỹ thuật trong câu truy vấn bằng cụm trung tính.}}{27}{figure.caption.21}%
\contentsline {figure}{\numberline {18}{\ignorespaces Macro-F1 và cluster-bootstrap intervals của ba phương án review polarity. Khoảng tin cậy của lexicon và logistic regression chồng lấn đáng kể.}}{28}{figure.caption.23}%
\contentsline {figure}{\numberline {19}{\ignorespaces Confusion matrix của logistic regression trên tập test. Nhãn mixed không đồng nghĩa với một kiểu câu review đơn nhất.}}{29}{figure.caption.24}%
\contentsline {figure}{\numberline {20}{\ignorespaces Phân vị thời gian tìm kiếm local. Không gồm network, browser hoặc tải đồng thời.}}{30}{figure.caption.26}%
